@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="material-dark" />
</HeadContent>

<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2" class="rz-ps-3 w-100">
            <RadzenIcon Icon="add_task" />
            <RadzenLabel Text="Task Management App" class="rz-p-3" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>
